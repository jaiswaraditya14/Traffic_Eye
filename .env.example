# Traffic Eye - public mobile configuration
# Copy this file to .env for local app development. Never commit private env files.
# These values are bundled into the mobile app; they are not server secrets.
# Keep the Supabase project used by the existing Google OAuth sign-in flow.
EXPO_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI providers are configured ONLY in Supabase Edge Function secrets:
# TOKENHARBOR_API_KEY_1, TOKENHARBOR_API_KEY_2 (Primary)
# NVIDIA_API_KEY_1, NVIDIA_API_KEY_2, NVIDIA_API_KEY_3 (Secondary / Vision Fallback)
# GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY_3 (Fallback)
# GROQ_API_KEY_1, GROQ_API_KEY_2, GROQ_API_KEY_3,
# GROQ_API_KEY_4, GROQ_API_KEY_5, GROQ_API_KEY_6 (Audit Fallback)
# Do not add provider keys, the Supabase service-role key, or OAuth client secrets
# to this file, the app's .env, Expo public variables, or EAS mobile variables.
# Google OAuth credentials stay in Supabase Auth's Google provider settings.
# Setup and owner rotation actions: docs/AI_PHASE1_SETUP.md

# Traffic Eye - Environment Variables Setup
# Copy this file to .env and fill in the values.
# IMPORTANT: Never commit the .env file to Git!

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyA_your_gemini_key_here

# Supabase Configuration (Obtain from https://app.supabase.com/)
EXPO_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

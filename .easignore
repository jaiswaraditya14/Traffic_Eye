# Dependencies
node_modules/

# Expo / build artifacts
.expo/
dist/
web-build/

# Environment files must never enter the mobile build upload, including nested
# Edge Function env files. EAS public Supabase variables are configured separately.
.env*
**/.env*
!/.env.example

# Server-only AI code and developer benchmarks are not mobile application assets.
supabase/functions/
supabase/migrations/
supabase/tests/
scripts/benchmark_ai_*.js

# Native folders
# NOTE: android/ is intentionally NOT excluded here.
# This project uses bare-workflow native modules (MediaStoreResolverModule.kt,
# MediaStoreResolverPackage.kt) that are registered in MainApplication.kt.
# These files cannot survive an EAS prebuild step, so the full android/
# directory must be uploaded to EAS and used as-is (bare-workflow EAS build).
# DO NOT add android/ back to this file.
#
# Gradle build caches — generated by local builds, NOT needed by EAS.
# Excluding these keeps the EAS upload ~12 MB instead of ~786 MB.
android/app/build/
android/app/.cxx/
android/.gradle/
android/build/
android/.kotlin/
ios/

# Git
.git/

# Database dumps / temp
database/
supabase/.temp/
docs/

# IDE / System
.DS_Store
*.log
